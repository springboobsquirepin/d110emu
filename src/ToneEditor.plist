<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    ToneEditor.app's Info.plist (macOS), which tools/macos-app.sh puts in the app bundle. The identifier is for builds of
    your own: change it to a name of yours before signing the app with an Apple developer ID.
-->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>ToneEditor</string>
    <key>CFBundleIdentifier</key>
    <string>local.d110emu.ToneEditor</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>ToneEditor</string>
    <key>CFBundleDisplayName</key>
    <string>ToneEditor</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.music</string>
    <!-- Without it, macOS draws the window at half the resolution of a Retina display, scaled up. -->
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <!-- SysEx files, whose tones go to the library: dropped on the Dock icon, or Open With in Finder. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>SysEx file</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>syx</string>
                <string>dat</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
